GITHUB_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PATH=.refactory/chroma
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_AI_RESPONSES=false
CACHE_PATH=.refactory/cache
AI_PROVIDER=mock
# AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
IGNORE_DIRS=.git,node_modules,dist,build,venv,.venv,__pycache__,.refactory,.pytest_cache,.mypy_cache

# CLI → control plane
REFACTORY_BACKEND_URL=http://127.0.0.1:8000
# Optional override for token file (default: ~/.refactory/auth.json)
# REFACTORY_AUTH_PATH=

# Refactory Backend (control plane server)
REFACTORY_ENV=development
REFACTORY_DEBUG=false
REFACTORY_DATABASE_URL=sqlite:///./refactory_backend.db
REFACTORY_JWT_SECRET=dev-only-change-me-refactory-control-plane
REFACTORY_JWT_ALGORITHM=HS256
REFACTORY_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFACTORY_REFRESH_TOKEN_EXPIRE_DAYS=14
REFACTORY_SEED_ADMIN_EMAIL=cli@refactory.dev
REFACTORY_SEED_ADMIN_PASSWORD=refactory-dev
REFACTORY_SEED_ADMIN_NAME=CLI Developer
